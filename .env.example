# Supabase project credentials (from https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# GitHub OAuth (for local dev with supabase CLI)
SUPABASE_AUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
SUPABASE_AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# GitHub PAT para Fase 1 Warp Factories (build-time, cliente). Crear en https://github.com/settings/tokens (classic) con scope `repo`.
# Vite requiere prefijo VITE_ y restart del dev server tras editar web/.env
# VITE_GITHUB_TOKEN=
