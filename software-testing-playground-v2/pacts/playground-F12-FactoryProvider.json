{
  "consumer": {
    "name": "playground-F12"
  },
  "interactions": [
    {
      "description": "a request to cancel an already done job (409)",
      "providerStates": [
        {
          "name": "a job that is done",
          "params": {
            "id": "job-f12-done01"
          }
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "path": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^\\/factory\\/jobs\\/job-f12-done01\\/cancel$"
              }
            ]
          }
        },
        "method": "POST",
        "path": "/factory/jobs/job-f12-done01/cancel"
      },
      "response": {
        "body": {
          "error": "job already done"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": ".*already (done|error).*"
                }
              ]
            }
          }
        },
        "status": 409
      }
    },
    {
      "description": "a request to cancel nonexistent job (404)",
      "providerStates": [
        {
          "name": "no job exists"
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "path": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^\\/factory\\/jobs\\/job-notexist-99\\/cancel$"
              }
            ]
          }
        },
        "method": "POST",
        "path": "/factory/jobs/job-notexist-99/cancel"
      },
      "response": {
        "body": {
          "error": "job not found: job-notexist-99"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": ".*job not found.*"
                }
              ]
            }
          }
        },
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "14.0.0"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "FactoryProvider"
  }
}